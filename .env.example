# Copy this file to .env (root) for docker-compose local development.
# Never commit the real .env file.

# Local Postgres password used by docker-compose + Backend DATABASE_URL
POSTGRES_PASSWORD=change-me-local-only

# JWT signing secret for the backend auth routes
JWT_SECRET=change-me-local-only

# MongoDB Atlas connection string (reviews + request logs)
MONGO_URI="mongodb+srv://USER:PASSWORD@cluster0.xxx.mongodb.net/ecommerce-logs?appName=Cluster0"

# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGIN=http://localhost:5173
