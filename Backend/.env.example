# Copy to Backend/.env for local development. Never commit the real file.

# Supabase (or local) PostgreSQL connection string
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/ecommerce_db"

# JWT signing secret
JWT_SECRET=change-me-local-only

# MongoDB Atlas connection string (reviews + request logs)
MONGO_URI="mongodb+srv://USER:PASSWORD@cluster0.xxx.mongodb.net/ecommerce-logs?appName=Cluster0"

# Comma-separated allowed origins for CORS
CORS_ORIGIN=http://localhost:5173

# Vercel sets this automatically in production; do not set it locally.
# VERCEL=1
